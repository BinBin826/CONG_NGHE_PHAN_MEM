{
  "name": "palaceguide-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "apps/dashboard",
    "packages/shared"
  ],
  "scripts": {
    "mobile:web": "npm --workspace apps/mobile run web",
    "dev:all": "concurrently -n web,dashboard -c blue,green \"npm run web:dev\" \"npm run dashboard:dev\"",
    "web:dev": "npm --workspace apps/web run dev",
    "web:build": "npm --workspace apps/web run build",
    "dashboard:dev": "npm --workspace apps/dashboard run dev",
    "mobile:start": "npm --workspace apps/mobile run start",
    "mobile:export": "npm --workspace apps/mobile run export",
    "test": "npm --workspace apps/web run test"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },

  "overrides": {
  "react": "19.3.0",
  "react-dom": "19.3.0"
}
}
